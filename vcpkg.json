{
  "name": "ruvia",
  "version-string": "1.0.0",
  "builtin-baseline": "28e2bd9c120210315ac31066952fcbfd45789e27",
  "default-features": [
    "runtime",
    "protocol",
    "http2",
    "http3",
    "http3-openssl",
    "framework"
  ],
  "features": {
    "runtime": {
      "description": "Dependencies for the ruvia-core runtime library.",
      "dependencies": [
        "asio",
        {
          "name": "mimalloc",
          "default-features": false,
          "features": [
            {
              "name": "override",
              "platform": "!windows"
            }
          ]
        }
      ]
    },
    "protocol": {
      "description": "Dependencies for the standalone HTTP/1, content-coding and WebSocket protocol library.",
      "dependencies": [
        "brotli",
        "zlib",
        "zstd"
      ]
    },
    "http2": {
      "description": "Enable HTTP/2 through nghttp2.",
      "dependencies": [
        "nghttp2"
      ]
    },
    "http3": {
      "description": "Enable sans-I/O HTTP/3 and QUIC through nghttp3 and ngtcp2.",
      "dependencies": [
        "nghttp3",
        {
          "name": "ngtcp2",
          "version>=": "1.26.0"
        }
      ]
    },
    "http3-openssl": {
      "description": "Enable the ngtcp2 OpenSSL QUIC adapter used by ruvia-web.",
      "dependencies": [
        {
          "name": "ngtcp2",
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "framework": {
      "description": "Dependencies for the complete ruvia-web framework.",
      "dependencies": [
        "openssl"
      ]
    },
    "mariadb": {
      "description": "Build MariaDB-compatible database APIs.",
      "dependencies": [
        {
          "name": "libmariadb",
          "features": [
            "openssl"
          ]
        }
      ]
    },
    "postgresql": {
      "description": "Build PostgreSQL database APIs.",
      "dependencies": [
        "libpq"
      ]
    },
    "redis": {
      "description": "Build Redis client APIs.",
      "dependencies": [
        "hiredis"
      ]
    }
  }
}
